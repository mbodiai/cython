class SpawnBase:
    def __init__(
            self,
            command: str | list[str] | None = None,
            args: list[str] | None = None,
            timeout: float | None = 30,
            maxread: int = 2000,
            searchwindowsize: int | None = None,
            encoding: str | None = None,
            codec_errors: str = "strict",
            cwd: str | Path | None = None,
            env: dict[str, str] | None = None,
    ):
            """Initialize process attributes and ensure compatibility with Command."""
            # Process attributes
            self.terminated: bool = True
            self.exitstatus: int | None = None
            self.signalstatus: int | None = None
            self.child_fd: int | None = -1
            self.timeout: float | None = timeout
            self.maxread: int = maxread
            self.searchwindowsize: int | None = searchwindowsize
            self.closed: bool = True  # Ensure process starts as "closed"
            
            # Platform detection
            self.platform_is_windows = sys.platform == "win32"
            
            # Set command and arguments
            if isinstance(command, str):
                # If command is a string, wrap it in a shell
                self.cmd = ["bash", "-c", command] if not self.platform_is_windows else ["cmd.exe", "/c", command]
            elif isinstance(command, list):
                # Command is already a list
                self.cmd = command
            else:
                raise ValueError("Command must be a string or list of strings")

            self.args = args or []
            self.cwd = Path(cwd).resolve() if cwd else Path.cwd()
            self.env = env or os.environ.copy()

            # Encoding setup
            self.encoding = encoding
            self.codec_errors = codec_errors
            self.stdin: TextIO = sys.stdin
            self.stdout: TextIO = sys.stdout
            self.stderr: TextIO = sys.stderr

            if encoding is None:
                # No encoding: use raw bytes
                self._encoder = self._decoder = self._NullCoder()
                self.crlf = b"\r\n"
                self.linesep = os.linesep.encode("ascii")
                self._buffer = BytesIO()
            else:
                # Encoding enabled: setup text-based processing
                self._encoder = codecs.getincrementalencoder(encoding)(codec_errors)
                self._decoder = codecs.getincrementaldecoder(encoding)(codec_errors)
                self.crlf = "\r\n"
                self.linesep = os.linesep
                self._buffer = StringIO()

            # Default encoding for Windows (UTF-8) and Unix (locale-based)
            if encoding is None:
                if self.platform_is_windows:
                    self.encoding = "utf-8"
                else:
                    import locale
                    self.encoding = locale.getpreferredencoding(False)

