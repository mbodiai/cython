        def expect(self, pattern: Any | list[Any], timeout: float | None = -1) -> int:
            """Waits for one of the patterns to appear in the output."""
            compiled_pattern_list = self.compile_pattern_list(pattern)
            return self.expect_list(compiled_pattern_list, timeout)
        
        def expect_list(self, pattern_list: list[Any], timeout: float | None = -1) -> int:
            """Matches output against a list of patterns."""
            if timeout == -1:
                timeout = self.timeout
        
            searcher = searcher_re(pattern_list)
            return self.expect_loop(searcher, timeout)
        
        def expect_exact(self, pattern_list: Any | list[Any], timeout: float | None = -1) -> int:
            """Matches exact strings instead of regex."""
            if isinstance(pattern_list, (str, bytes)):
                pattern_list = [pattern_list]
        
            pattern_list = [self._coerce_expect_string(p) for p in pattern_list]
            searcher = self.searcher_string(pattern_list)
            return self.expect_loop(searcher, timeout)
        
        def expect_loop(self, searcher, timeout: float | None = -1) -> int:
            """Searches output for a pattern with a timeout."""
            exp = Expecter(self, searcher)
            return exp.expect_loop(timeout)
        
        def compile_pattern_list(self, patterns):
            """Compiles patterns into regex objects if needed."""
            if not isinstance(patterns, list):
                patterns = [patterns]
        
            compiled_patterns = []
            for p in patterns:
                if isinstance(p, (str, bytes)):
                    p = self._coerce_expect_string(p)
                    compiled_patterns.append(re.compile(p))
                else:
                    compiled_patterns.append(p)
            return compiled_patterns
        
        def fileno(self) -> int:
            """Returns the file descriptor of the child process."""
            return self.child_fd if self.child_fd is not None else -1
        
        def isatty(self) -> bool:
            """Returns True if the process is attached to a terminal."""
            return os.isatty(self.child_fd) if self.child_fd else False
        
        def _validate_fd(self) -> bool:
            """Checks if the file descriptor is valid."""
            if self.child_fd is None or self.child_fd < 0:
                return False
            try:
                os.fstat(self.child_fd)
                return True
            except OSError:
                return False
        
        def close(self) -> None:
            """Closes the process file descriptor safely."""
            if self._validate_fd():
                os.close(self.child_fd)
            self.child_fd = -1
            self.closed = True
        def read(self, size: int = -1) -> AnyStrT:
            """Reads up to `size` bytes/chars from the process."""
            if size == 0:
                return self._buffer.getvalue()
            if size < 0:
                return self._buffer.read()
            return self._buffer.read(size)
        
        def readline(self, size: int = -1) -> AnyStrT:
            """Reads a single line up to `size` bytes/chars."""
            return self._buffer.readline(size)
        
        def readlines(self, sizehint: int = -1) -> list[AnyStrT]:
            """Reads all lines, optionally hinting at size."""
            return self._buffer.readlines(sizehint)
        
