{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "$id": "unix.json",
  "$dynamicAnchor": "environment",
  "title": "Unix Environment Variables Configuration Schema",
  "type": "object",
  "properties": {
    "PATH": {
      "type": "string",
      "description": "Path environment variable.",
      "default": "/usr/local/bin:/usr/bin:/bin"
    },
    "HOME": {
      "type": "string",
      "description": "Home directory.",
      "default": "/home/user"
    },
    "LANG": {
      "type": "string",
      "description": "Locale settings.",
      "default": "en_US.UTF-8"
    }
  },
  "required": ["PATH", "HOME", "LANG"],
  "additionalProperties": true
}

