{
    "$schema": "http://json-schema.org/draft/2020-12/schema",
    "$id": "cpp.json",
    "$dynamicAnchor": "cpp",
    "title": "C/C++ Configuration Schema",
    "type": "object",
    "properties": {
        "compiler": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "string",
                    "description": "Name of the C/C++ compiler.",
                    "default": {
                        "$dynamicRef": "#/$defs/cppCompiler/name"
                    }
                },
                "version": {
                    "type": "string",
                    "description": "Version of the C/C++ compiler.",
                    "default": {
                        "$dynamicRef": "#/$defs/cppStandard/version"
                }
            },
            "additionalProperties": false
        },
        "cppStandard": {
            "type": "string",
            "description": "C++ standard to use.",
            "default": {
                "$dynamicRef": "#/$defs/cppStandard"
            }
        },
        "buildOptions": {
            "type": "object",
            "properties": {
                "optimizationLevel": {
                    "type": "string",
                    "enum": ["O0", "O1", "O2", "O3", "Os"],
                    "default": "O2"
                },
                "warnings": {
                    "type": "string",
                    "enum": ["all", "extra", "pedantic", "none"],
                    "default": "all"
                },
                "debugSymbols": {
                    "type": "boolean",
                    "description": "Include debug symbols in the build.",
                    "default": true
                }
            },
            "additionalProperties": false
        },
        "cFlags": {
            "type": "array",
            "description": "Additional C flags to pass to the compiler.",
            "items": {
                "type": "string"
            },
            "default": []
        },
        "cxxFlags": {
            "type": "array",
            "description": "Additional C++ flags to pass to the compiler.",
            "items": {
                "type": "string"
            },
            "default": []
        },
        "cmakePresets": {
            "$dynamicAnchor": "cmakePresets",
            "type": "object",
            "additionalProperties": true
        }
    },
    "$defs": {
      "cppCompiler": {
        "$ref": "./system_defaults.json#/properties/cppCompiler"
      },
      "cppStandard": {
        "$ref": "./system_defaults.json#/properties/cppStandard"
      }
    },
    "additionalProperties": false
  }
}