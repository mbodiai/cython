{
    "$schema": "http://json-schema.org/draft/2020-12/schema",
    "$id": "defaults.json",
    "$dynamicAnchor": "defaults",
    "title": "System-specific Build Defaults",
    "type": "object",
    "properties": {
        "cppCompiler": {
            "type": "object",
            "properties": {
                "name": {
                    "type": "const",
                    "const": "gcc"
                },
                "version": {
                    "type": "const",
                    "const": "10"
                }
            },
        },
        "cppStandard": {
            "type": "const",
            "const": "c++17"
        }
    }
}
