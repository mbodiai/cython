{
  "$schema": "http://json-schema.org/draft/2020-12/schema",
  "$id": "mb.json",
  "title": "MB Configuration Schema",
  "description": "Schema for managing the main MB project configurations.",
  "type": "object",
  "properties": {
      "cpp": {
          "$dynamicRef": "#/$defs/cpp"
      },
      "python": {
          "$dynamicRef": "#/$defs/python"
      },
      "project": {
          "type": "object",
          "description": "Project-specific configurations.",
          "properties": {
              "name": {
                  "type": "string",
                  "description": "Name of the project.",
                  "default": "mb_project",
                  "pattern": "^[a-zA-Z0-9-_]+$"
              },
              "version": {
                  "type": "string",
                  "description": "Version of the project.",
                  "default": "1.0.0"
              },
              "repository": {
                  "type": "string",
                  "description": "URL of the project's repository.",
                  "format": "uri",
                  "default": ""
              },
              "license": {
                  "type": "string",
                  "description": "License of the project.",
                  "enum": ["MIT", "Apache-2.0", "GPL-3.0", "BSD-3-Clause", "Proprietary"],
                  "default": "MIT"
              }
          },
          "required": ["name", "version"],
          "additionalProperties": false
      },
      "environment": {
          "$dynamicRef": "#/$defs/environment"
      },
      "build": {
          "type": "object",
          "description": "Build configurations.",
          "properties": {
              "buildDirectory": {
                  "type": "string",
                  "description": "Directory where build artifacts are stored.",
                  "default": "${HOME}/.mb/build",
                  "pattern": "^\\/[^\\s]*$"
              },
              "installDirectory": {
                  "type": "string",
                  "description": "Directory where output binaries are placed.",
                  "default": "${HOME}/.mb/install",
                  "pattern": "^\\/[^\\s]*$"
              }
          },
          "additionalProperties": false
      }
  },
  "required": ["cpp", "python", "project", "build"],
  "additionalProperties": false,
  "$defs": {
      "cpp": {
          "$ref": "./cpp.json"
      },
      "environment": {
          "$ref": "./unix.json"
      },
      "python": {
          "$ref": "./python.json"
      }
  }
}