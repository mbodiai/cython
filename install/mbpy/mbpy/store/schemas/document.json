{  
  "$schema": "https://json-schema.org/draft/2020-12/schema",  
  "$id": "hierarchical-structure.json",  
  "title": "Universal Hierarchical Structure Schema",  
  "type": "object",  
  "properties": {  
    "tag": {  
      "type": "string",  
      "description": "Element type identifier with content type",  
      "$dynamicRef": "#/$defs/TagDefinition"  
    },  
    "transition_rule": {  
      "type": "string",  
      "description": "Element separation pattern",  
      "default": "\n",  
      "$dynamicRef": "#/$defs/TransitionRule"  
    },  
    "nesting_rule": {  
      "type": "string",  
      "description": "Hierarchical structure pattern",  
      "default": "\t",  
      "$dynamicRef": "#/$defs/NestingRule"  
    },  
    "summary": {  
      "type": "array",  
      "items": {  
        "type": "string",  
        "pattern": "^(@ref:)[A-Za-z0-9_-]+$"  
      },  
      "description": "References to elements for summary",  
      "$dynamicRef": "#/$defs/SummaryDefinition"  
    }  
  },  
  "required": ["tag"],  
  "$defs": {  
    "TagDefinition": {  
      "$dynamicAnchor": "TagDefinition",  
      "type": "string",  
      "description": "Extensible tag definition including content type and validation"  
    },  
    "TransitionRule": {  
      "$dynamicAnchor": "TransitionRule",  
      "type": "string",  
      "description": "Context-sensitive transition patterns"  
    },  
    "NestingRule": {  
      "$dynamicAnchor": "NestingRule",  
      "type": "string",  
      "description": "Hierarchical structure patterns with inheritance"  
    },  
    "SummaryDefinition": {  
      "$dynamicAnchor": "SummaryDefinition",  
      "type": "string",  
      "description": "Reference patterns for summary generation"  
    }  
  }  
}