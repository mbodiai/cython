{  
  "$schema": "https://json-schema.org/draft/2020-12/schema",  
  "$id": "academic-document.json",  
  "title": "Academic Document Schema",  
  "type": "object",  
  "properties": {  
    "tag": {  
      "type": "string",  
      "enum": [  
        "DOCUMENT",  
        "FRONT_MATTER",  
        "CHAPTER",  
        "SECTION",  
        "SUBSECTION",  
        "THEOREM",  
        "PROOF",  
        "DEFINITION",  
        "EXAMPLE",  
        "REMARK",  
        "REFERENCE",  
        "CITATION",  
        "BIBLIOGRAPHY"  
      ]  
    },  
    "content": {  
      "type": "string",  
      "minLength": 1  
    },  
    "identifier": {  
      "type": "string",  
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"  
    },  
    "transition_rule": {  
      "type": "string",  
      "enum": ["\n", "\n\n", ". ", ": "],  
      "default": "\n"  
    },  
    "nesting_rule": {  
      "type": "string",  
      "enum": ["\t", "    "],  
      "default": "\t"  
    },  
    "page": {  
      "type": "integer",  
      "minimum": 1  
    },  
    "lines": {  
      "type": "string",  
      "pattern": "^[0-9]+(-[0-9]+)?$"  
    },  
    "summary": {  
      "type": "array",  
      "items": {  
        "type": "string",  
        "pattern": "^(@ref:)[A-Za-z0-9_-]+$"  
      }  
    }  
  },  
  "required": ["tag", "content", "identifier"],  
  "dependentSchemas": {  
    "tag": {  
      "if": {  
        "properties": {  
          "tag": { "const": "DOCUMENT" }  
        }  
      },  
      "then": {  
        "properties": {  
          "document_type": {  
            "type": "string",  
            "enum": ["BOOK", "THESIS", "PAPER"]  
          }  
        },  
        "required": ["document_type"]  
      }  
    }  
  },  
  "dependentRequired": {  
    "THEOREM": ["proof_ref"]  
  }  
}